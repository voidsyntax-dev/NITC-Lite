<?xml version="1.0" encoding="utf-8"?>
<!-- WiFi credentials never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wifi.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wifi.xml" />
    </device-transfer>
</data-extraction-rules>
